{
	"name": "n8n-nodes-discoveryone",
	"version": "0.1.1",
	"description": "DiscoveryONE for n8n: start workflows on DiscoveryONE events, and read and write leads, customers, follow-ups and more.",
	"license": "MIT",
	"homepage": "https://github.com/jared-discovery/DiscoveryN8n",
	"keywords": [
		"n8n-community-node-package",
		"discoveryone",
		"construction",
		"crm"
	],
	"author": {
		"name": "Discovery Systems",
		"email": "support@discovery-systems.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jared-discovery/DiscoveryN8n.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test": "n8n-node build && node --test \"test/*.test.mjs\""
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/DiscoveryOneApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/DiscoveryOne/DiscoveryOne.node.js",
			"dist/nodes/DiscoveryOneTrigger/DiscoveryOneTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.56.4",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
